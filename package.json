{
  "name": "tcg-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline, restricted-profile Pokemon TCG simulation research",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "eval": "node scripts/evaluate.mjs",
    "eval:suite": "node scripts/evaluate-suite.mjs",
    "coverage:report": "node scripts/coverage-audit.mjs",
    "coverage:require-full": "node scripts/coverage-audit.mjs coverage/standard-2026-10-19.json --require-full",
    "engine:prepare": "node scripts/twinleaf-prepare.mjs",
    "engine:smoke": "node scripts/twinleaf-smoke.mjs",
    "engine:audit": "node scripts/twinleaf-audit.mjs",
    "local:probe": "node integrations/local-worker/probe.mjs",
    "local:native": "node scripts/native.mjs",
    "play": "node scripts/play-checkpoint.mjs",
    "ladder:summary": "node scripts/ladder-records.mjs",
    "ladder:native": "node scripts/run-native-ladder.mjs",
    "ladder:report": "node scripts/report-native-ladder.mjs",
    "bench": "node scripts/benchmark.mjs",
    "tutorial": "node scripts/serve-tutorial.mjs",
    "profile": "node --cpu-prof --cpu-prof-dir=runs scripts/benchmark.mjs --games 1000 --repeats 1 --output runs/profile-benchmark.json",
    "foundation:prepare": "node scripts/prepare-first-baseline.mjs",
    "foundation:verify": "node scripts/verify-first-baseline.mjs"
  },
  "license": "MIT"
}
